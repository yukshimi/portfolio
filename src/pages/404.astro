---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import Container from "../components/astro/Container.astro";
import Button from "../components/astro/Button.astro";
import Footer from "../components/astro/Footer.astro";
import { profile } from "../data/profile";

// 404.html が無いと Cloudflare Pages が SPA とみなし、存在しないURL（robots.txt など）にもトップページを返してしまう
---

<BaseLayout title={`Page not found | ${profile.name}`}>
  <Header />
  <main id="main" class="py-section-gap min-h-[80dvh]">
    <Container class="flex flex-col items-start gap-item-gap">
      <div class="flex flex-col items-start gap-thin-gap">
        <h1 class="text-4xl sm:text-5xl leading-relaxed sm:leading-relaxed">
          Page not found
        </h1>
        <p class="opacity-50 leading-8">
          お探しのページは見つかりませんでした。
        </p>
      </div>
      <Button href="/" variant="primary">
        Back to top
      </Button>
    </Container>
  </main>
  <Footer profile={profile} />
</BaseLayout>
