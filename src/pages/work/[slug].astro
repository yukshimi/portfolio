---
import { existsSync } from "node:fs";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/astro/Header.astro";
import About from "../../components/astro/About.astro";
import Container from "../../components/astro/Container.astro";
import Footer from "../../components/astro/Footer.astro";
import WorkGrid from "../../components/astro/WorkGrid.astro";
import { getAllWorks } from "../../data/works";
import { profile } from "../../data/profile";
import { toMetaDescription } from "../../utils/meta";

// 静的生成のための全スラッグを取得
export const getStaticPaths = (async () => {
  const entries = await getCollection("works");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const work = entry.data;
// 下部の作品一覧には、いま表示している作品を含めない
const otherWorks = (await getAllWorks()).filter((w) => w.slug !== entry.id);
const { Content } = await render(entry);

const description = work.detailDescription || work.description;
// 共有用画像は public/ogp/<スラッグ>.jpg。無い作品はデフォルト画像を使う
const ogpImage = `/ogp/${entry.id}.jpg`;
const shareImage = existsSync(`public${ogpImage}`) ? ogpImage : undefined;

const metaDescription = toMetaDescription(
  [work.company, String(work.year), description].join(" / "),
);
---

<BaseLayout
  title={`${work.title} | ${profile.name}`}
  description={metaDescription}
  image={shareImage}
>
  <Header />
  <main id="main" class="flex flex-col gap-section-gap">
    <article class="flex flex-col gap-item-gap pt-item-gap pb-section-gap">
      <Container as="header" class="flex flex-col items-start gap-item-gap">
        <div class="flex flex-col items-start gap-2">
          <h1 class="text-3xl sm:text-5xl leading-snug sm:leading-snug">
            {work.projectTitle ?? work.title}
          </h1>
          {work.url && (
            <a
              href={work.url}
              target="_blank"
              rel="noreferrer"
              class="mt-2 text-sm opacity-50 break-all hover:opacity-100"
            >
              {work.url}
            </a>
          )}
        </div>

        <div class="flex flex-col sm:flex-row flex-wrap items-start sm:items-center gap-min-gap sm:gap-thin-gap">
          <p>
            <b>{work.company}</b>
          </p>
          <div class="flex flex-row items-center gap-3">
            <img src="/img/icon/calendar.svg" alt="Year" class="block" />
            <p>{work.year}</p>
          </div>
          <div class="flex flex-row items-center gap-3">
            <img src="/img/icon/tag.svg" alt="Category" class="block" />
            <p>{work.category}</p>
          </div>
        </div>

        <p class="opacity-50 leading-8">{description}</p>
      </Container>

      {entry.body?.trim() && (
        <Container as="section" aria-label="Work detail">
          <h2 class="sr-only">Work detail</h2>
          <div class="work-markdown w-full min-w-0 max-w-full">
            <Content />
          </div>
        </Container>
      )}
    </article>
    <hr class="w-[90vw] max-w-[1400px] mx-auto border-0 border-t border-line" />
    <WorkGrid works={otherWorks} size="sm" />
    <About profile={profile} />
  </main>
  <Footer profile={profile} />
</BaseLayout>
