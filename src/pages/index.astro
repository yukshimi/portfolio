---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import Hero from "../components/astro/Hero.astro";
import WorkGrid from "../components/astro/WorkGrid.astro";
import About from "../components/astro/About.astro";
import Footer from "../components/astro/Footer.astro";
import { getAllWorks } from "../data/works";
import { profile } from "../data/profile";
import { toMetaDescription } from "../utils/meta";

const works = await getAllWorks();
const metaDescription = toMetaDescription(
  `${profile.name}, ${profile.role}. ` +
    profile.careers
      .map((career) => [career.company, career.role].filter(Boolean).join(" "))
      .join(" / "),
);
---

<BaseLayout title={`${profile.name} — Portfolio`} description={metaDescription}>
  <Header />
  <main id="main">
    <Hero title={`${profile.name}'s Portfolio`} />
    <WorkGrid works={works} size="lg" />
    <About profile={profile} />
  </main>
  <Footer profile={profile} />
</BaseLayout>
