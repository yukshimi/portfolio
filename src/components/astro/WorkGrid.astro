---
import type { Work } from "../../types";
import Container from "./Container.astro";

interface Props {
  works: Work[];
  /** カードサイズ: 大（lg）= トップページ / 小（sm）= 作品詳細ページ下部 */
  size?: "lg" | "sm";
}

const { works, size = "lg" } = Astro.props;

const styles = {
  lg: {
    section: "py-section-gap",
    grid: "gap-item-gap grid-cols-3 max-[800px]:grid-cols-1",
    title: "text-base",
  },
  sm: {
    section: "py-div-gap",
    grid: "gap-[calc(var(--item-gap)/2)] grid-cols-4 max-[1000px]:grid-cols-3 max-[800px]:grid-cols-2",
    title: "text-sm",
  },
}[size];
---

<section id="work" class={styles.section}>
  <Container>
    <h2 class="sr-only">Work</h2>
    <div class:list={["grid", styles.grid]}>
      {works.map((work, index) => (
        <a
          href={`/work/${work.slug}/`}
          data-reveal
          style={`--reveal-delay: ${index * 60}ms;`}
          class="group block"
        >
          <div class="flex flex-col gap-3">
            <div class="aspect-square overflow-hidden">
              <div
                class="w-full h-full bg-center bg-cover transition-transform duration-500 ease-out will-change-transform group-hover:scale-105"
                style={`background-image: url('${work.thumbnail}');`}
              />
            </div>
            <div class="flex flex-col gap-1">
              <h3 class={styles.title} set:html={work.title} />
              <p class="text-xs opacity-50">{work.category}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
