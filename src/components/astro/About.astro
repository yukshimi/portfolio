---
import type { Profile } from "../../types";
import Button from "./Button.astro";
import Container from "./Container.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section id="about" class="py-section-gap bg-dark/5">
  <Container
    width="narrow"
    class="flex flex-row items-start gap-item-gap max-[800px]:flex-col"
  >
    <div
      class="aspect-square w-[280px] max-w-[45%] bg-center bg-cover flex-none max-[800px]:w-full max-[800px]:max-w-none"
      style={`background-image: url('${profile.avatar}');`}
    ></div>
    <div class="flex flex-col items-start gap-item-gap flex-1">
      <div class="flex flex-col items-start gap-thin-gap">
        <div>
          <h2 class="text-box-trim-both-cap">About me</h2>
          <p class="mt-4 break-keep text-left">
            <b>{profile.name}</b>, {profile.role}
          </p>
        </div>
        {/*
          経歴とスキル・資格で左列（年・ラベル）の幅を揃えるため、
          親のグリッドを subgrid で共有する。左列は最も長い表記に合わせて自動で決まる
        */}
        <div class="grid w-full grid-cols-[max-content_1fr] gap-x-8 gap-y-8 text-sm leading-6 max-[800px]:flex max-[800px]:flex-col">
          <ol class="col-span-full grid grid-cols-subgrid max-[800px]:block">
            {profile.careers.map((career) => (
              <li class="col-span-full grid grid-cols-subgrid py-4 border-t border-line first:border-t-0 first:pt-0 max-[800px]:block">
                <p class="whitespace-nowrap text-sm leading-6 opacity-50 max-[800px]:mb-1">
                  {career.period}
                </p>
                <div>
                  <h3 class="text-sm leading-6">{career.company}</h3>
                  {career.role && (
                    <p class="text-sm leading-6 break-keep text-left">
                      {career.role}
                    </p>
                  )}
                  {career.description && (
                    <p class="mt-1 text-sm leading-6 opacity-50">
                      {career.description}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
          <dl class="col-span-full grid grid-cols-subgrid gap-y-2 break-normal text-left max-[800px]:flex max-[800px]:flex-col">
            <div class="col-span-full grid grid-cols-subgrid max-[800px]:block">
              <dt class="whitespace-nowrap opacity-50">Skills</dt>
              <dd class="opacity-50">{profile.skills.join(" / ")}</dd>
            </div>
            <div class="col-span-full grid grid-cols-subgrid max-[800px]:block">
              <dt class="whitespace-nowrap opacity-50">保有資格</dt>
              <dd class="opacity-50">
                {profile.qualifications.map((qualification, index) => (
                  <>
                    {index > 0 && "、"}
                    <span class="whitespace-nowrap">{qualification}</span>
                  </>
                ))}
              </dd>
            </div>
          </dl>
        </div>
        {profile.interviewUrls.length > 0 && (
          <ul class="flex flex-row items-center gap-thin-gap opacity-50">
            {profile.interviewUrls.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noreferrer"
                  class="underline"
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <Button as="button" variant="primary" attrs={{ "data-contact-open": "" }}>
        Get in touch
      </Button>
    </div>
  </Container>
</section>
