---
import type { Profile } from "../../types";
import Button from "./Button.astro";
import Container from "./Container.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section id="about" class="py-section-gap bg-dark/5">
  <Container
    width="narrow"
    class="flex flex-row items-start gap-item-gap max-[800px]:flex-col"
  >
    <div
      class="aspect-square w-[280px] max-w-[45%] bg-center bg-cover flex-none max-[800px]:w-full max-[800px]:max-w-none"
      style={`background-image: url('${profile.avatar}');`}
    ></div>
    <div class="flex flex-col items-start gap-item-gap flex-1">
      <div class="flex flex-col items-start gap-thin-gap">
        <div>
          <h2 class="text-box-trim-both-cap">About me</h2>
          <p class="mt-4">
            <b>{profile.name}</b>, {profile.role}
          </p>
        </div>
        <ol class="w-full">
          {profile.careers.map((career) => (
            <li class="grid grid-cols-[7rem_1fr] gap-4 py-4 border-t border-line first:border-t-0 first:pt-0 max-[800px]:grid-cols-1 max-[800px]:gap-1">
              <p class="text-sm leading-7 opacity-50">{career.period}</p>
              <div>
                <h3 class="text-sm leading-7">
                  {career.company}
                  {career.role && (
                    <span class="font-normal opacity-50"> / {career.role}</span>
                  )}
                </h3>
                {career.description && (
                  <p class="text-sm leading-7 opacity-50">
                    {career.description}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
        <dl class="flex flex-col gap-1 text-sm leading-7 break-normal text-left">
          <div class="flex flex-row gap-4 max-[800px]:flex-col max-[800px]:gap-0">
            <dt class="flex-none w-[7rem] opacity-50">Skills</dt>
            <dd class="opacity-50">{profile.skills.join(" / ")}</dd>
          </div>
          <div class="flex flex-row gap-4 max-[800px]:flex-col max-[800px]:gap-0">
            <dt class="flex-none w-[7rem] opacity-50">保有資格</dt>
            <dd class="opacity-50">{profile.qualifications.join("、")}</dd>
          </div>
        </dl>
        {profile.interviewUrls.length > 0 && (
          <ul class="flex flex-row items-center gap-thin-gap opacity-50">
            {profile.interviewUrls.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noreferrer"
                  class="underline"
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <Button as="button" variant="primary" attrs={{ "data-contact-open": "" }}>
        Get in touch
      </Button>
    </div>
  </Container>
</section>
