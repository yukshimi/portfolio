---
import type { Profile } from "../../types";
import Container from "./Container.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<footer class="bg-line">
  <Container class="flex flex-row items-center justify-between gap-item-gap py-item-gap max-[800px]:flex-col-reverse [&>*]:flex-none">
    <small class="opacity-50">
      © {new Date().getFullYear()} — {profile.name}
    </small>
    <span class="flex flex-row items-center gap-thin-gap max-[800px]:flex-wrap">
      <small class="opacity-50">Follow me:</small>
      <span class="flex flex-row items-center gap-1.5">
        {profile.socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noreferrer"
            class="p-1.5 rounded-[8rem] hover:bg-line hover:scale-110 transition-all duration-200"
          >
            <img src={social.icon} alt={social.platform} class="block" />
          </a>
        ))}
      </span>
    </span>
  </Container>
</footer>
